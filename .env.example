# Convex Deployment
NEXT_PUBLIC_CONVEX_URL="https://your-deployment.convex.cloud"
CONVEX_DEPLOYMENT="dev:your-deployment"

# Authentication for sync endpoints
INTERNAL_SYNC_SECRET="your-internal-sync-secret-key"

# xAI Grok API Key for AI explanations and market summaries
XAI_API_KEY="xai-your-api-key"
XAI_MODEL="grok-2-latest"
